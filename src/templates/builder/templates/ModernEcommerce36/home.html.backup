      <h2 class="heading-lg editable-text editable-section no-drop-zone" data-section="99" data-text="81" style="text-align:center; margin-bottom:var(--space-md);">Questions? We've got answers.</h2>
      <div style="max-width:700px; margin:0 auto;">
        <div class="faq-item editable-section no-drop-zone" data-section="100"><div class="faq-question editable-text editable-section no-drop-zone" data-target="faq1" data-section="101" data-text="82">What size should I choose? <i class="fas fa-chevron-down"></i></div><div class="faq-answer editable-text editable-section no-drop-zone" id="faq1" data-section="102" data-text="83">We recommend ordering your usual size. The hoodie has a refined oversized fit—size down for a slimmer look.</div></div>
        <div class="faq-item editable-section no-drop-zone" data-section="103"><div class="faq-question editable-text editable-section no-drop-zone" data-target="faq2" data-section="104" data-text="84">Is the hoodie oversized? <i class="fas fa-chevron-down"></i></div><div class="faq-answer editable-text editable-section no-drop-zone" id="faq2" data-section="105" data-text="85">Yes, it's designed with a relaxed, structured oversized fit that still feels tailored.</div></div>
        <div class="faq-item editable-section no-drop-zone" data-section="106"><div class="faq-question editable-text editable-section no-drop-zone" data-target="faq3" data-section="107" data-text="86">What material is it made from? <i class="fas fa-chevron-down"></i></div><div class="faq-answer editable-text editable-section no-drop-zone" id="faq3" data-section="108" data-text="87">Heavyweight 100% structured cotton blend, 450gsm for durability and comfort.</div></div>
        <div class="faq-item editable-section no-drop-zone" data-section="109"><div class="faq-question editable-text editable-section no-drop-zone" data-target="faq4" data-section="110" data-text="88">How should I wash it? <i class="fas fa-chevron-down"></i></div><div class="faq-answer editable-text editable-section no-drop-zone" id="faq4" data-section="111" data-text="89">Machine wash cold inside out, hang dry to maintain structure and color.</div></div>
        <div class="faq-item editable-section no-drop-zone" data-section="112"><div class="faq-question editable-text editable-section no-drop-zone" data-target="faq5" data-section="113" data-text="90">How long does shipping take? <i class="fas fa-chevron-down"></i></div><div class="faq-answer editable-text editable-section no-drop-zone" id="faq5" data-section="114" data-text="91">Standard shipping 3-5 business days. Express available at checkout.</div></div>
        <div class="faq-item editable-section no-drop-zone" data-section="115"><div class="faq-question editable-text editable-section no-drop-zone" data-target="faq6" data-section="116" data-text="92">What is your return policy? <i class="fas fa-chevron-down"></i></div><div class="faq-answer editable-text editable-section no-drop-zone" id="faq6" data-section="117" data-text="93">30-day hassle-free returns on unworn items with tags.</div></div>
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="section-padding editable-section" data-section="118" style="padding-top:0;">
    <div class="container">
      <div class="final-cta editable-section no-drop-zone" data-section="119">
        <h2 class="heading-lg editable-text editable-section no-drop-zone" data-section="120" data-text="94">YOUR EVERYDAY, UPGRADED.</h2>
        <p style="font-size:1.2rem; opacity:0.8; margin:var(--space-xs) 0;" class="editable-text editable-section no-drop-zone" data-section="121" data-text="95">One hoodie. Built properly.</p>
        <a href="#product-selection" class="primary-action editable-text editable-section no-drop-zone" data-section="122" data-text="96"><i class="fas fa-bolt"></i> Shop Now</a>
      </div>
    </div>
  </section>

  <!-- CONTACT FORM (below footer) -->
  <section class="contact-section editable-section" id="contact" data-section="123">
    <div class="container">
      <div class="contact-grid">
        <div class="contact-info">
          <span class="eyebrow editable-text editable-section no-drop-zone" data-section="124" data-text="97">Get in touch</span>
          <h2 class="heading-lg editable-text editable-section no-drop-zone" data-section="125" data-text="98">We'd love to hear from you.</h2>
          <p class="body-large editable-text editable-section no-drop-zone" data-section="126" data-text="99" style="max-width:400px;">Have questions about sizing, shipping, or just want to say hello? Reach out anytime.</p>
          <div class="contact-detail editable-text editable-section no-drop-zone" data-section="127" data-text="100">
            <i class="fas fa-envelope"></i>
            <span>hello@north01.com</span>
          </div>
          <div class="contact-detail editable-text editable-section no-drop-zone" data-section="128" data-text="101">
            <i class="fas fa-phone"></i>
            <span>+1 (800) 555‑0199</span>
          </div>
          <div class="contact-detail editable-text editable-section no-drop-zone" data-section="129" data-text="102">
            <i class="fas fa-map-marker-alt"></i>
            <span>New York, NY</span>
          </div>
          <div style="display:flex; gap:var(--space-sm); margin-top:var(--space-xs); font-size:1.4rem; color:var(--color-text-secondary);">
            <a href="#" aria-label="Instagram" class="editable-icon" data-icon="102"><i class="fab fa-instagram"></i></a>
            <a href="#" aria-label="TikTok" class="editable-icon" data-icon="103"><i class="fab fa-tiktok"></i></a>
            <a href="#" aria-label="X" class="editable-icon" data-icon="104"><i class="fab fa-x-twitter"></i></a>
          </div>
        </div>

        <div class="contact-form-wrapper editable-section no-drop-zone" data-section="130">
          <form id="contactForm" novalidate>
            <div class="form-row">
              <div class="form-group">
                <label for="contactName" class="editable-text editable-section no-drop-zone" data-section="131" data-text="103">Full Name</label>
                <input type="text" id="contactName" class="editable-text editable-section no-drop-zone" data-section="132" data-text="104" placeholder="Your name" required />
              </div>
              <div class="form-group">
                <label for="contactEmail" class="editable-text editable-section no-drop-zone" data-section="133" data-text="105">Email Address</label>
                <input type="email" id="contactEmail" class="editable-text editable-section no-drop-zone" data-section="134" data-text="106" placeholder="you@example.com" required />
              </div>
            </div>
            <div class="form-group">
              <label for="contactSubject" class="editable-text editable-section no-drop-zone" data-section="135" data-text="107">Subject</label>
              <input type="text" id="contactSubject" class="editable-text editable-section no-drop-zone" data-section="136" data-text="108" placeholder="What's this about?" required />
            </div>
            <div class="form-group">
              <label for="contactMessage" class="editable-text editable-section no-drop-zone" data-section="137" data-text="109">Message</label>
              <textarea id="contactMessage" class="editable-text editable-section no-drop-zone" data-section="138" data-text="110" placeholder="Tell us everything..." required></textarea>
            </div>
            <button type="submit" class="submit-action editable-text editable-section no-drop-zone" data-section="139" data-text="111">
              <i class="fas fa-paper-plane"></i> Send Message
            </button>
            <div id="formSuccess" class="form-success">
              <i class="fas fa-check-circle" style="margin-right:8px;"></i> Thanks! We'll get back to you within 24 hours.
            </div>
            <div id="formError" class="form-error">
              <i class="fas fa-exclamation-circle" style="margin-right:8px;"></i> Please fill in all fields correctly.
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="site-footer editable-section" data-section="140">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-col"><h4 class="editable-text editable-section no-drop-zone" data-section="141" data-text="112">NORTH/01</h4><p style="font-size:0.85rem; color:var(--color-text-secondary);" class="editable-text editable-section no-drop-zone" data-section="142" data-text="113">Built for the city. Designed to outlast the moment.</p></div>
        <div class="footer-col"><h4 class="editable-text editable-section no-drop-zone" data-section="143" data-text="114">Navigate</h4><a href="#hero" class="editable-text editable-section no-drop-zone" data-section="144" data-text="115">Home</a><a href="#product-selection" class="editable-text editable-section no-drop-zone" data-section="145" data-text="116">Shop</a><a href="#story" class="editable-text editable-section no-drop-zone" data-section="146" data-text="117">Story</a><a href="#details" class="editable-text editable-section no-drop-zone" data-section="147" data-text="118">Details</a><a href="#reviews" class="editable-text editable-section no-drop-zone" data-section="148" data-text="119">Reviews</a><a href="#faq" class="editable-text editable-section no-drop-zone" data-section="149" data-text="120">FAQ</a></div>
        <div class="footer-col"><h4 class="editable-text editable-section no-drop-zone" data-section="150" data-text="121">Customer Care</h4><a href="#contact" class="editable-text editable-section no-drop-zone" data-section="151" data-text="122">Contact</a><a href="#" class="editable-text editable-section no-drop-zone" data-section="152" data-text="123">Shipping</a><a href="#" class="editable-text editable-section no-drop-zone" data-section="153" data-text="124">Returns</a><a href="#" class="editable-text editable-section no-drop-zone" data-section="154" data-text="125">Size Guide</a></div>
        <div class="footer-col"><h4 class="editable-text editable-section no-drop-zone" data-section="155" data-text="126">Connect</h4><a href="#" class="editable-text editable-section no-drop-zone" data-section="156" data-text="127"><i class="fab fa-instagram" style="margin-right:6px;"></i> Instagram</a><a href="#" class="editable-text editable-section no-drop-zone" data-section="157" data-text="128"><i class="fab fa-tiktok" style="margin-right:6px;"></i> TikTok</a><a href="#" class="editable-text editable-section no-drop-zone" data-section="158" data-text="129"><i class="fab fa-x-twitter" style="margin-right:6px;"></i> X</a></div>
      </div>
      <div style="text-align:center; margin-top:var(--space-lg); font-size:0.8rem; color:var(--color-text-secondary); border-top:1px solid var(--color-border-subtle); padding-top:var(--space-md);" class="editable-text editable-section no-drop-zone" data-section="159" data-text="130">&copy; 2025 NORTH/01. All rights reserved. Privacy &bull; Terms</div>
    </div>
  </footer>

  <!-- STICKY BAR -->
  <div id="stickyBar" class="sticky-purchase">
    <div class="sticky-info">
      <strong class="editable-text editable-section no-drop-zone" data-section="160" data-text="131">NORTH/01 Signature Hoodie</strong>
      <span style="color:var(--color-text-secondary);" id="stickyPrice" class="editable-text editable-section no-drop-zone" data-section="161" data-text="132">$89</span>
      <span id="stickySize" class="editable-text editable-section no-drop-zone" data-section="162" data-text="133">M</span>
      <span id="stickyColor" style="display:inline-block; width:16px; height:16px; border-radius:50%; background:#1e1e1e; border:1px solid var(--color-border-subtle);"></span>
    </div>
    <div class="sticky-actions">
      <button id="stickyAddToCart" class="sticky-btn-cart editable-text editable-section no-drop-zone" data-section="163" data-text="134"><i class="fas fa-shopping-bag"></i> Add</button>
      <button id="stickyBuyNow" class="sticky-btn-buy editable-text editable-section no-drop-zone" data-section="164" data-text="135"><i class="fas fa-bolt"></i> Buy</button>
    </div>
  </div>

  <script>
    (function() {
      "use strict";

      // ----- DOM refs -----
      const hamburger = document.getElementById('hamburgerBtn');
      const mobileNavOverlay = document.getElementById('mobileNavOverlay');
      const mobileNavDrawer = document.getElementById('mobileNavDrawer');
      const closeMobileNav = document.getElementById('closeMobileNav');
      const cartTrigger = document.getElementById('cartTrigger');
      const cartOverlay = document.getElementById('cartOverlay');
      const cartDrawer = document.getElementById('cartDrawer');
      const closeCart = document.getElementById('closeCart');
      const cartItems = document.getElementById('cartItems');
      const cartFooter = document.getElementById('cartFooter');
      const cartSubtotal = document.getElementById('cartSubtotal');
      const cartTotal = document.getElementById('cartTotal');
      const cartCount = document.getElementById('cartCount');
      const mobileCartCount = document.getElementById('mobileCartCount');
      const addToCartBtn = document.getElementById('addToCartBtn');
      const buyNowBtn = document.getElementById('buyNowBtn');
      const stickyAddToCart = document.getElementById('stickyAddToCart');
      const stickyBuyNow = document.getElementById('stickyBuyNow');
      const qtyDisplay = document.getElementById('qtyDisplay');
      const qtyDec = document.getElementById('qtyDec');
      const qtyInc = document.getElementById('qtyInc');
      const sizeSelector = document.getElementById('sizeSelector');
      const colorSelector = document.getElementById('colorSelector');
      const stickySize = document.getElementById('stickySize');
      const stickyColor = document.getElementById('stickyColor');
      const stickyPrice = document.getElementById('stickyPrice');
      const displayPrice = document.getElementById('displayPrice');
      const mainImage = document.getElementById('mainProductImage');
      const toast = document.getElementById('toast');
      const viewer = document.getElementById('imageViewer');
      const viewerImg = document.getElementById('viewerImage');
      const closeViewer = document.getElementById('closeViewer');
      const galleryItems = document.querySelectorAll('.gallery-item img');
      const faqQuestions = document.querySelectorAll('.faq-question');
      const reviewGrid = document.getElementById('reviewGrid');
      const writeReviewBtn = document.getElementById('writeReviewBtn');
      const heroVideoTrigger = document.getElementById('heroVideoTrigger');
      const heroVideoModal = document.getElementById('heroVideoModal');
      const closeHeroVideo = document.getElementById('closeHeroVideo');
      const heroWatchFilmBtn = document.getElementById('heroWatchFilmBtn');
      const heroVideoIframe = document.getElementById('heroVideoIframe');
      const thumbnailStrip = document.getElementById('thumbnailStrip');
      const bundleSelector = document.getElementById('bundleSelector');
      const sizeGuideBtn = document.getElementById('sizeGuideBtn');

      // Contact form
      const contactForm = document.getElementById('contactForm');
      const formSuccess = document.getElementById('formSuccess');
      const formError = document.getElementById('formError');

      // ----- state -----
      let cart = [];
      let quantity = 1;
      let selectedSize = 'M';
      let selectedColor = 'Midnight Black';
      let selectedBundle = 1;
      let bundlePrice = 89;
      const colorMap = {
        'Midnight Black': { hex: '#1e1e1e', image: 'https://images.unsplash.com/photo-1618354691373-d851c5c3a990?w=800&h=800&fit=crop&crop=center&auto=format' },
        'Stone': { hex: '#c6bdb2', image: 'https://images.unsplash.com/photo-1556905055-8f358a7a47b2?w=800&h=800&fit=crop&crop=center&auto=format' },
        'Bone': { hex: '#e8dfd3', image: 'https://images.unsplash.com/photo-1576566588028-4147f3842f27?w=800&h=800&fit=crop&crop=center&auto=format' }
      };

      // ----- helpers -----
      function updateCartUI() {
        const totalItems = cart.reduce((sum, item) => sum + item.qty, 0);
        cartCount.textContent = totalItems;
        mobileCartCount.textContent = totalItems;
        if (cart.length === 0) {
          cartItems.innerHTML = `<div class="cart-empty-state"><i class="fas fa-tshirt"></i><p>Your rotation starts here.</p><a href="#product-selection" style="text-decoration:underline; font-weight:500;">Shop the hoodie</a></div>`;
          cartFooter.style.display = 'none';
        } else {
          let html = '';
          let subtotal = 0;
          cart.forEach((item, idx) => {
            const itemTotal = item.qty * item.price;
            subtotal += itemTotal;
            html += `
              <div class="cart-item">
                <img src="${item.image || 'https://images.unsplash.com/photo-1618354691373-d851c5c3a990?w=100&h=100&fit=crop&crop=center&auto=format'}" alt="hoodie">
                <div class="cart-item-details">
                  <h4>NORTH/01 Signature Hoodie</h4>
                  <p>${item.size} · ${item.color}</p>
                  <p>$${itemTotal.toFixed(2)}</p>
                </div>
                <button class="cart-item-remove" data-index="${idx}"><i class="fas fa-times"></i></button>
              </div>
            `;
          });
          cartItems.innerHTML = html;
          cartFooter.style.display = 'block';
          cartSubtotal.textContent = `$${subtotal.toFixed(2)}`;
          cartTotal.textContent = `$${subtotal.toFixed(2)}`;
          document.querySelectorAll('.cart-item-remove').forEach(btn => {
            btn.addEventListener('click', function() {
              const idx = parseInt(this.dataset.index);
              cart.splice(idx, 1);
              updateCartUI();
              showToast('Removed from rotation.');
            });
          });
        }
      }

      function showToast(msg) {
        toast.textContent = msg;
        toast.classList.add('show');
        clearTimeout(toast._timer);
        toast._timer = setTimeout(() => toast.classList.remove('show'), 2200);
      }

      function getCurrentVariant() {
        const perUnit = bundlePrice / selectedBundle;
        return {
          size: selectedSize,
          color: selectedColor,
          qty: quantity * selectedBundle,
          price: perUnit,
          image: colorMap[selectedColor]?.image || colorMap['Midnight Black'].image
        };
      }

      function addToCartAction() {
        const variant = getCurrentVariant();
        const existing = cart.find(item => item.size === variant.size && item.color === variant.color);
        if (existing) {
          existing.qty += variant.qty;
        } else {
          cart.push({ ...variant });
        }
        updateCartUI();
        showToast('Added to your rotation.');
        cartTrigger.style.transform = 'scale(1.2)';
        setTimeout(() => cartTrigger.style.transform = 'scale(1)', 200);
        cartOverlay.classList.add('open');
        cartDrawer.classList.add('open');
      }

      function buyNowAction() {
        addToCartAction();
      }

      function updatePrice() {
        const perUnit = bundlePrice / selectedBundle;
        const total = perUnit * quantity;
        displayPrice.textContent = `$${total.toFixed(0)}`;
        stickyPrice.textContent = `$${total.toFixed(0)}`;
      }

      function updateColorImage(color) {
        const colorData = colorMap[color];
        if (colorData && mainImage) {
          mainImage.style.opacity = '0.6';
          setTimeout(() => {
            mainImage.src = colorData.image;
            mainImage.style.opacity = '1';
          }, 150);
        }
        stickyColor.style.background = colorData?.hex || '#1e1e1e';
      }

      // ----- bundle -----
      bundleSelector.addEventListener('click', (e) => {
        const btn = e.target.closest('button');
        if (!btn) return;
        bundleSelector.querySelectorAll('button').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        selectedBundle = parseInt(btn.dataset.bundle);
        bundlePrice = parseInt(btn.dataset.price);
        updatePrice();
      });

      // ----- size -----
      sizeSelector.addEventListener('click', (e) => {
        const btn = e.target.closest('button');
        if (!btn) return;
        sizeSelector.querySelectorAll('button').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        selectedSize = btn.dataset.size;
        stickySize.textContent = selectedSize;
      });

      // ----- color -----
      colorSelector.addEventListener('click', (e) => {
        const btn = e.target.closest('button');
        if (!btn) return;
        colorSelector.querySelectorAll('button').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        selectedColor = btn.dataset.color;
        updateColorImage(selectedColor);
      });

      // ----- quantity -----
      qtyDec.addEventListener('click', () => {
        if (quantity > 1) { quantity--; qtyDisplay.textContent = quantity; updatePrice(); }
      });
      qtyInc.addEventListener('click', () => {
        quantity++; qtyDisplay.textContent = quantity; updatePrice();
      });

      // ----- action buttons -----
      addToCartBtn.addEventListener('click', addToCartAction);
      buyNowBtn.addEventListener('click', buyNowAction);
      stickyAddToCart.addEventListener('click', addToCartAction);
      stickyBuyNow.addEventListener('click', buyNowAction);

      // ----- thumbnails -----
      thumbnailStrip.addEventListener('click', (e) => {
        const img = e.target.closest('img');
        if (!img) return;
        thumbnailStrip.querySelectorAll('img').forEach(i => i.classList.remove('active'));
        img.classList.add('active');
        if (img.dataset.main && mainImage) {
          mainImage.style.opacity = '0.6';
          setTimeout(() => {
            mainImage.src = img.dataset.main;
            mainImage.style.opacity = '1';
          }, 150);
        }
      });

      // ----- mobile nav -----
      function openMobileNav() {
        mobileNavOverlay.classList.add('open');
        mobileNavDrawer.classList.add('open');
        document.body.style.overflow = 'hidden';
      }
      function closeMobileNavFn() {
        mobileNavOverlay.classList.remove('open');
        mobileNavDrawer.classList.remove('open');
        document.body.style.overflow = '';
      }
      hamburger.addEventListener('click', openMobileNav);
      closeMobileNav.addEventListener('click', closeMobileNavFn);
      mobileNavOverlay.addEventListener('click', closeMobileNavFn);
      document.querySelectorAll('.mobile-nav-links a').forEach(link => {
        link.addEventListener('click', closeMobileNavFn);
      });

      // ----- cart drawer -----
      cartTrigger.addEventListener('click', () => {
        cartOverlay.classList.add('open');
        cartDrawer.classList.add('open');
      });
      closeCart.addEventListener('click', () => {
        cartOverlay.classList.remove('open');
        cartDrawer.classList.remove('open');
      });
      cartOverlay.addEventListener('click', () => {
        cartOverlay.classList.remove('open');
        cartDrawer.classList.remove('open');
      });

      // ----- sticky bar -----
      let stickyVisible = false;
      const productSelectionTop = document.getElementById('product-selection').offsetTop - 100;
      window.addEventListener('scroll', () => {
        const scrollY = window.scrollY;
        if (scrollY > productSelectionTop && !stickyVisible) {
          document.getElementById('stickyBar').classList.add('visible');
          stickyVisible = true;
        } else if (scrollY <= productSelectionTop && stickyVisible) {
          document.getElementById('stickyBar').classList.remove('visible');
          stickyVisible = false;
        }
      });

      // ----- hero video -----
      function openHeroVideo() {
        heroVideoModal.classList.add('open');
        document.body.style.overflow = 'hidden';
        heroVideoIframe.src = 'https://www.youtube.com/embed/dQw4w9WgXcQ?autoplay=1&mute=1&rel=0';
      }
      function closeHeroVideoFn() {
        heroVideoModal.classList.remove('open');
        document.body.style.overflow = '';
        heroVideoIframe.src = 'https://www.youtube.com/embed/dQw4w9WgXcQ?rel=0&mute=1';
      }
      heroVideoTrigger.addEventListener('click', openHeroVideo);
      heroWatchFilmBtn.addEventListener('click', openHeroVideo);
      closeHeroVideo.addEventListener('click', closeHeroVideoFn);
      heroVideoModal.addEventListener('click', (e) => {
        if (e.target === heroVideoModal) closeHeroVideoFn();
      });

      // ----- gallery viewer -----
      galleryItems.forEach(img => {
        img.addEventListener('click', () => {
          viewerImg.src = img.dataset.full || img.src;
          viewer.classList.add('open');
          document.body.style.overflow = 'hidden';
        });
      });
      closeViewer.addEventListener('click', () => {
        viewer.classList.remove('open');
        document.body.style.overflow = '';
      });
      viewer.addEventListener('click', (e) => {
        if (e.target === viewer) { viewer.classList.remove('open'); document.body.style.overflow = ''; }
      });

      // ----- FAQ -----
      faqQuestions.forEach(q => {
        q.addEventListener('click', function() {
          const targetId = this.dataset.target;
          const answer = document.getElementById(targetId);
          const isOpen = answer.classList.contains('open');
          document.querySelectorAll('.faq-answer').forEach(a => a.classList.remove('open'));
          document.querySelectorAll('.faq-question').forEach(q2 => q2.classList.remove('open'));
          if (!isOpen) {
            answer.classList.add('open');
            this.classList.add('open');
          }
        });
      });

      // ----- write review -----
      writeReviewBtn.addEventListener('click', () => {
        const name = prompt('Your name:');
        if (!name) return;
        const rating = prompt('Rating (1-5):');
        const reviewText = prompt('Your review:');
        if (!reviewText) return;
        const stars = '★'.repeat(Math.min(5, Math.max(1, parseInt(rating) || 5)));
        const card = document.createElement('div');
        card.className = 'review-card';
        card.innerHTML = `
          <div class="stars">${stars}</div>
          <p>"${reviewText}"</p>
          <div class="review-meta"><span><strong>${name}</strong> <span style="color:var(--color-success);">✓ Verified</span></span><span>Just now</span></div>
        `;
        reviewGrid.prepend(card);
        card.style.opacity = '0';
        requestAnimationFrame(() => { card.style.transition = 'opacity 0.5s'; card.style.opacity = '1'; });
      });

      // ----- size guide -----
      sizeGuideBtn.addEventListener('click', () => {
        alert('Size Guide: XS (34-36), S (36-38), M (38-40), L (40-42), XL (42-44), XXL (44-46). Model is 6\'1" wearing M.');
      });

      // ----- contact form -----
      contactForm.addEventListener('submit', function(e) {
        e.preventDefault();
        const name = document.getElementById('contactName').value.trim();
        const email = document.getElementById('contactEmail').value.trim();
        const subject = document.getElementById('contactSubject').value.trim();
        const message = document.getElementById('contactMessage').value.trim();

        // Simple validation
        if (!name || !email || !subject || !message || !email.includes('@')) {
          formError.classList.add('show');
          formSuccess.classList.remove('show');
          setTimeout(() => formError.classList.remove('show'), 4000);
          return;
        }

        // Simulate sending (in production, this would be a fetch/axios call)
        formError.classList.remove('show');
        formSuccess.classList.add('show');

        // Reset form
        contactForm.reset();

        setTimeout(() => {
          formSuccess.classList.remove('show');
        }, 5000);
      });

      // ----- init -----
      updateCartUI();
      updateColorImage('Midnight Black');
      stickySize.textContent = 'M';
      updatePrice();

    })();
  </script>
</body>
</html>