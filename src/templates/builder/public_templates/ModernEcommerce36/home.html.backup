        <div class="text-wrap">
          <span class="eyebrow" id="section-58">{{ text_contents.53|default:"Why NORTH/01" }}</span>
          <h2 class="heading-lg" id="section-59">{{ text_contents.54|default:"Most hoodies are either comfortable <em>or</em> well-structured. We wanted both." }}</h2>
          <p class="body-large" id="section-60">{{ text_contents.55|default:"We believe everyday clothing shouldn't feel ordinary. The Signature Hoodie is built with a structured heavyweight fabric, refined oversized fit, and reinforced construction—designed to outlast the moment." }}</p>
          <div class="comparison-grid">
            <div class="comparison-item" id="section-61"><h4>{{ text_contents.56|default:"Ordinary Hoodie" }}</h4><ul><li>✕ {{ text_contents.57|default:"Loses shape" }}</li><li>✕ {{ text_contents.58|default:"Lightweight fabric" }}</li><li>✕ {{ text_contents.59|default:"Generic fit" }}</li></ul></div>
