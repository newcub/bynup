        <div class="gallery-item"><img src="https://images.unsplash.com/photo-1576566588028-4147f3842f27?w=400&h=400&fit=crop&crop=center&auto=format" alt="Back" data-full="https://images.unsplash.com/photo-1576566588028-4147f3842f27?w=800&fit=crop&crop=center&auto=format" loading="lazy" /></div>
        <div class="gallery-item"><img src="https://images.unsplash.com/photo-1618354691373-d851c5c3a990?w=400&h=400&fit=crop&crop=center&auto=format" alt="Fabric" data-full="https://images.unsplash.com/photo-1618354691373-d851c5c3a990?w=800&fit=crop&crop=center&auto=format" loading="lazy" /></div>
        <div class="gallery-item"><img src="https://images.unsplash.com/photo-1576871337632-b9aef4c17ab9?w=400&h=400&fit=crop&crop=center&auto=format" alt="Hood" data-full="https://images.unsplash.com/photo-1576871337632-b9aef4c17ab9?w=800&fit=crop&crop=center&auto=format" loading="lazy" /></div>
        <div class="gallery-item"><img src="https://images.unsplash.com/photo-1618354691551-44de113f0164?w=400&h=400&fit=crop&crop=center&auto=format" alt="Sleeve" data-full="https://images.unsplash.com/photo-1618354691551-44de113f0164?w=800&fit=crop&crop=center&auto=format" loading="lazy" /></div>
        <div class="gallery-item"><img src="https://images.unsplash.com/photo-1618354691373-d851c5c3a990?w=400&h=400&fit=crop&crop=center&auto=format" alt="Lifestyle" data-full="https://images.unsplash.com/photo-1618354691373-d851c5c3a990?w=800&fit=crop&crop=center&auto=format" loading="lazy" /></div>
      </div>
    </div>
  </section>

  <!-- UGC -->
  <section class="section-padding editable-section" data-section="79" style="padding-top:0;">
    <div class="container">
      <span class="eyebrow" id="section-80" style="display:block; text-align:center;">{{ text_contents.83|default:"Worn your way" }}</span>
      <h2 class="heading-lg" id="section-81" style="text-align:center; margin-bottom:var(--space-sm);">{{ text_contents.84|default:"Real people, real hoodie." }}</h2>
      <p style="text-align:center; color:var(--color-text-secondary); margin-bottom:var(--space-md);" id="section-82">{{ text_contents.85|default:"Unboxing • Lifestyle • Reviews" }}</p>
      <div class="ugc-grid">
        <div class="ugc-card" id="section-83">
          <video muted loop playsinline poster="https://images.unsplash.com/photo-1618354691551-44de113f0164?w=400&h=600&fit=crop&crop=center&auto=format">
            <source src="#" type="video/mp4" />
          </video>
          <div class="play-icon-ugc"><i class="fas fa-play-circle"></i></div>
          <div class="subtitles" id="section-84">{{ text_contents.86|default:'"Perfect fit, amazing quality"' }}</div>
          <div class="ugc-overlay"><span class="verified">✓ Verified</span> @citydweller</div>
        </div>
        <div class="ugc-card" id="section-85">
          <video muted loop playsinline poster="https://images.unsplash.com/photo-1618354691373-d851c5c3a990?w=400&h=600&fit=crop&crop=center&auto=format">
            <source src="#" type="video/mp4" />
          </video>
          <div class="play-icon-ugc"><i class="fas fa-play-circle"></i></div>
          <div class="subtitles" id="section-86">{{ text_contents.87|default:'"Best hoodie I\'ve owned"' }}</div>
          <div class="ugc-overlay"><span class="verified">✓ Verified</span> @minimal.movement</div>
        </div>
        <div class="ugc-card" id="section-87">
          <video muted loop playsinline poster="https://images.unsplash.com/photo-1576566588028-4147f3842f27?w=400&h=600&fit=crop&crop=center&auto=format">
            <source src="#" type="video/mp4" />
          </video>
          <div class="play-icon-ugc"><i class="fas fa-play-circle"></i></div>
          <div class="subtitles" id="section-88">{{ text_contents.88|default:'"Unreal fabric quality"' }}</div>
          <div class="ugc-overlay"><span class="verified">✓ Verified</span> @studio.mono</div>
        </div>
      </div>
    </div>
  </section>

  <!-- REVIEWS -->
  <section id="reviews" class="section-padding editable-section" data-section="89" style="padding-top:0;">
    <div class="container">
      <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:var(--space-sm);">
        <div>
          <span class="eyebrow" id="section-90">{{ text_contents.89|default:"Reviews" }}</span>
          <h2 class="heading-lg" id="section-91">4.9 / 5 <span style="font-size:1rem; color:#d4a04a;"><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i></span></h2>
          <p style="color:var(--color-text-secondary);" id="section-92">{{ text_contents.90|default:"2,400+ verified reviews" }}</p>
        </div>
        <button class="secondary-action" id="writeReviewBtn" id="section-93"><i class="fas fa-pen" style="margin-right:6px;"></i> {{ text_contents.91|default:"Write a Review" }}</button>
      </div>
      <div class="review-grid" id="reviewGrid">
        <div class="review-card" id="section-94"><div class="stars"><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i></div><p>{{ text_contents.92|default:'"Best hoodie I\'ve ever owned. The weight is perfect."' }}</p><div class="review-meta"><span><strong>Alex M.</strong> <span style="color:var(--color-success);">✓ Verified</span></span><span>2 days ago</span></div></div>
        <div class="review-card" id="section-95"><div class="stars"><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i></div><p>{{ text_contents.93|default:'"Incredible quality and the fit is exactly what I wanted."' }}</p><div class="review-meta"><span><strong>Jordan K.</strong> <span style="color:var(--color-success);">✓ Verified</span></span><span>1 week ago</span></div></div>
        <div class="review-card" id="section-96"><div class="stars"><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star-half-alt"></i></div><p>{{ text_contents.94|default:'"Almost perfect. The fabric is premium, will buy again."' }}</p><div class="review-meta"><span><strong>Sam R.</strong> <span style="color:var(--color-success);">✓ Verified</span></span><span>3 weeks ago</span></div></div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="section-padding editable-section" data-section="97" style="padding-top:0;">
    <div class="container">
      <span class="eyebrow" id="section-98" style="display:block; text-align:center;">{{ text_contents.95|default:"FAQ" }}</span>
      <h2 class="heading-lg" id="section-99" style="text-align:center; margin-bottom:var(--space-md);">{{ text_contents.96|default:"Questions? We've got answers." }}</h2>
      <div style="max-width:700px; margin:0 auto;">
        <div class="faq-item" id="section-100"><div class="faq-question" data-target="faq1" id="section-101">{{ text_contents.97|default:"What size should I choose?" }} <i class="fas fa-chevron-down"></i></div><div class="faq-answer" id="faq1" id="section-102">{{ text_contents.98|default:"We recommend ordering your usual size. The hoodie has a refined oversized fit—size down for a slimmer look." }}</div></div>
        <div class="faq-item" id="section-103"><div class="faq-question" data-target="faq2" id="section-104">{{ text_contents.99|default:"Is the hoodie oversized?" }} <i class="fas fa-chevron-down"></i></div><div class="faq-answer" id="faq2" id="section-105">{{ text_contents.100|default:"Yes, it's designed with a relaxed, structured oversized fit that still feels tailored." }}</div></div>
        <div class="faq-item" id="section-106"><div class="faq-question" data-target="faq3" id="section-107">{{ text_contents.101|default:"What material is it made from?" }} <i class="fas fa-chevron-down"></i></div><div class="faq-answer" id="faq3" id="section-108">{{ text_contents.102|default:"Heavyweight 100% structured cotton blend, 450gsm for durability and comfort." }}</div></div>
        <div class="faq-item" id="section-109"><div class="faq-question" data-target="faq4" id="section-110">{{ text_contents.103|default:"How should I wash it?" }} <i class="fas fa-chevron-down"></i></div><div class="faq-answer" id="faq4" id="section-111">{{ text_contents.104|default:"Machine wash cold inside out, hang dry to maintain structure and color." }}</div></div>
        <div class="faq-item" id="section-112"><div class="faq-question" data-target="faq5" id="section-113">{{ text_contents.105|default:"How long does shipping take?" }} <i class="fas fa-chevron-down"></i></div><div class="faq-answer" id="faq5" id="section-114">{{ text_contents.106|default:"Standard shipping 3-5 business days. Express available at checkout." }}</div></div>
        <div class="faq-item" id="section-115"><div class="faq-question" data-target="faq6" id="section-116">{{ text_contents.107|default:"What is your return policy?" }} <i class="fas fa-chevron-down"></i></div><div class="faq-answer" id="faq6" id="section-117">{{ text_contents.108|default:"30-day hassle-free returns on unworn items with tags." }}</div></div>
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="section-padding editable-section" data-section="118" style="padding-top:0;">
    <div class="container">
      <div class="final-cta" id="section-119">
        <h2 class="heading-lg" id="section-120">{{ text_contents.109|default:"YOUR EVERYDAY, UPGRADED." }}</h2>
        <p style="font-size:1.2rem; opacity:0.8; margin:var(--space-xs) 0;" id="section-121">{{ text_contents.110|default:"One hoodie. Built properly." }}</p>
        <a href="#product-selection" class="primary-action" id="section-122"><i class="fas fa-bolt"></i> {{ text_contents.111|default:"Shop Now" }}</a>
      </div>
    </div>
  </section>

  <!-- Component Drop Zone - Before Contact -->
  {% for component in components %}
    {% if component.drop_zone == '3' %}
      <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
        {{ component.html_content|safe }}
      </section>
    {% endif %}
  {% endfor %}

  <!-- CONTACT FORM -->
  <section class="contact-section editable-section" id="contact" data-section="123">
    <div class="container">
      <div class="contact-grid">
        <div class="contact-info">
          <span class="eyebrow" id="section-124">{{ text_contents.112|default:"Get in touch" }}</span>
          <h2 class="heading-lg" id="section-125">{{ text_contents.113|default:"We'd love to hear from you." }}</h2>
          <p class="body-large" id="section-126" style="max-width:400px;">{{ text_contents.114|default:"Have questions about sizing, shipping, or just want to say hello? Reach out anytime." }}</p>
          <div class="contact-detail" id="section-127">
            <i class="fas fa-envelope"></i>
            <span>{{ text_contents.115|default:"hello@north01.com" }}</span>
          </div>
          <div class="contact-detail" id="section-128">
            <i class="fas fa-phone"></i>
            <span>{{ text_contents.116|default:"+1 (800) 555-0199" }}</span>
          </div>
          <div class="contact-detail" id="section-129">
            <i class="fas fa-map-marker-alt"></i>
            <span>{{ text_contents.117|default:"New York, NY" }}</span>
          </div>
          <div style="display:flex; gap:var(--space-sm); margin-top:var(--space-xs); font-size:1.4rem; color:var(--color-text-secondary);">
            {% if page.social_media.all %}
              {% for social in page.social_media.all %}
                {% if social.is_active %}
                  <a href="{{ social.get_url }}" target="_blank" data-icon="{{ forloop.counter|add:100 }}">
                    <i class="{{ social.get_icon }}"></i>
                  </a>
                {% endif %}
              {% endfor %}
            {% else %}
              <a href="#" data-icon="102"><i class="fab fa-instagram"></i></a>
              <a href="#" data-icon="103"><i class="fab fa-tiktok"></i></a>
              <a href="#" data-icon="104"><i class="fab fa-x-twitter"></i></a>
            {% endif %}
          </div>
        </div>

        <div class="contact-form-wrapper" id="section-130">
          <form id="contactForm" novalidate>
            {% csrf_token %}
            <div class="form-row">
              <div class="form-group">
                <label for="contactName" id="section-131">{{ text_contents.118|default:"Full Name" }}</label>
                <input type="text" id="contactName" id="section-132" placeholder="{{ text_contents.119|default:'Your name' }}" required />
              </div>
              <div class="form-group">
                <label for="contactEmail" id="section-133">{{ text_contents.120|default:"Email Address" }}</label>
                <input type="email" id="contactEmail" id="section-134" placeholder="{{ text_contents.121|default:'you@example.com' }}" required />
              </div>
            </div>
            <div class="form-group">
              <label for="contactSubject" id="section-135">{{ text_contents.122|default:"Subject" }}</label>
              <input type="text" id="contactSubject" id="section-136" placeholder="{{ text_contents.123|default:'What\'s this about?' }}" required />
            </div>
            <div class="form-group">
              <label for="contactMessage" id="section-137">{{ text_contents.124|default:"Message" }}</label>
              <textarea id="contactMessage" id="section-138" placeholder="{{ text_contents.125|default:'Tell us everything...' }}" required></textarea>
            </div>
            <button type="submit" class="submit-action" id="section-139">
              <i class="fas fa-paper-plane"></i> {{ text_contents.126|default:"Send Message" }}
            </button>
            <div id="formSuccess" class="form-success">
              <i class="fas fa-check-circle" style="margin-right:8px;"></i> {{ text_contents.127|default:"Thanks! We'll get back to you within 24 hours." }}
            </div>
            <div id="formError" class="form-error">
              <i class="fas fa-exclamation-circle" style="margin-right:8px;"></i> {{ text_contents.128|default:"Please fill in all fields correctly." }}
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- Component Drop Zone - Footer -->
  {% for component in components %}
    {% if component.drop_zone == '4' %}
      <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
        {{ component.html_content|safe }}
      </section>
    {% endif %}
  {% endfor %}

  <!-- FOOTER -->
  <footer class="site-footer editable-section" data-section="140">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-col"><h4 id="section-141">{{ text_contents.129|default:"NORTH/01" }}</h4><p style="font-size:0.85rem; color:var(--color-text-secondary);" id="section-142">{{ text_contents.130|default:"Built for the city. Designed to outlast the moment." }}</p></div>
        <div class="footer-col"><h4 id="section-143">{{ text_contents.131|default:"Navigate" }}</h4><a href="#hero" id="section-144">{{ text_contents.132|default:"Home" }}</a><a href="#product-selection" id="section-145">{{ text_contents.133|default:"Shop" }}</a><a href="#story" id="section-146">{{ text_contents.134|default:"Story" }}</a><a href="#details" id="section-147">{{ text_contents.135|default:"Details" }}</a><a href="#reviews" id="section-148">{{ text_contents.136|default:"Reviews" }}</a><a href="#faq" id="section-149">{{ text_contents.137|default:"FAQ" }}</a></div>
        <div class="footer-col"><h4 id="section-150">{{ text_contents.138|default:"Customer Care" }}</h4><a href="#contact" id="section-151">{{ text_contents.139|default:"Contact" }}</a><a href="#" id="section-152">{{ text_contents.140|default:"Shipping" }}</a><a href="#" id="section-153">{{ text_contents.141|default:"Returns" }}</a><a href="#" id="section-154">{{ text_contents.142|default:"Size Guide" }}</a></div>
        <div class="footer-col"><h4 id="section-155">{{ text_contents.143|default:"Connect" }}</h4><a href="#" id="section-156"><i class="fab fa-instagram" style="margin-right:6px;"></i> {{ text_contents.144|default:"Instagram" }}</a><a href="#" id="section-157"><i class="fab fa-tiktok" style="margin-right:6px;"></i> {{ text_contents.145|default:"TikTok" }}</a><a href="#" id="section-158"><i class="fab fa-x-twitter" style="margin-right:6px;"></i> {{ text_contents.146|default:"X" }}</a></div>
      </div>
      <div style="text-align:center; margin-top:var(--space-lg); font-size:0.8rem; color:var(--color-text-secondary); border-top:1px solid var(--color-border-subtle); padding-top:var(--space-md);" id="section-159">&copy; 2025 NORTH/01. {{ text_contents.147|default:"All rights reserved. Privacy &bull; Terms" }}</div>
    </div>
  </footer>

  <!-- STICKY BAR -->
  <div id="stickyBar" class="sticky-purchase">
    <div class="sticky-info">
      <strong id="section-160">{{ text_contents.148|default:"NORTH/01 Signature Hoodie" }}</strong>
      <span style="color:var(--color-text-secondary);" id="stickyPrice" id="section-161">$89</span>
      <span id="stickySize" id="section-162">M</span>
      <span id="stickyColor" style="display:inline-block; width:16px; height:16px; border-radius:50%; background:#1e1e1e; border:1px solid var(--color-border-subtle);"></span>
    </div>
    <div class="sticky-actions">
      <button id="stickyAddToCart" class="sticky-btn-cart" id="section-163"><i class="fas fa-shopping-bag"></i> {{ text_contents.149|default:"Add" }}</button>
      <button id="stickyBuyNow" class="sticky-btn-buy" id="section-164"><i class="fas fa-bolt"></i> {{ text_contents.150|default:"Buy" }}</button>
    </div>
  </div>

  {% render_icon_script %}

  <script src="{% static 'builder/js/cart-manager.js' %}"></script>

  <script>
    (function() {
      "use strict";

      // ----- DOM refs -----
      const hamburger = document.getElementById('hamburgerBtn');
      const mobileNavOverlay = document.getElementById('mobileNavOverlay');
      const mobileNavDrawer = document.getElementById('mobileNavDrawer');
      const closeMobileNav = document.getElementById('closeMobileNav');
      const cartTrigger = document.getElementById('cartTrigger');
      const cartOverlay = document.getElementById('cartOverlay');
      const cartDrawer = document.getElementById('cartDrawer');
      const closeCart = document.getElementById('closeCart');
      const cartItems = document.getElementById('cartItems');
      const cartFooter = document.getElementById('cartFooter');
      const cartSubtotal = document.getElementById('cartSubtotal');
      const cartTotal = document.getElementById('cartTotal');
      const cartCount = document.getElementById('cartCount');
      const mobileCartCount = document.getElementById('mobileCartCount');
      const addToCartBtn = document.getElementById('addToCartBtn');
      const buyNowBtn = document.getElementById('buyNowBtn');
      const stickyAddToCart = document.getElementById('stickyAddToCart');
      const stickyBuyNow = document.getElementById('stickyBuyNow');
      const qtyDisplay = document.getElementById('qtyDisplay');
      const qtyDec = document.getElementById('qtyDec');
      const qtyInc = document.getElementById('qtyInc');
      const sizeSelector = document.getElementById('sizeSelector');
      const colorSelector = document.getElementById('colorSelector');
      const stickySize = document.getElementById('stickySize');
      const stickyColor = document.getElementById('stickyColor');
      const stickyPrice = document.getElementById('stickyPrice');
      const displayPrice = document.getElementById('displayPrice');
      const mainImage = document.getElementById('mainProductImage');
      const toast = document.getElementById('toast');
      const viewer = document.getElementById('imageViewer');
      const viewerImg = document.getElementById('viewerImage');
      const closeViewer = document.getElementById('closeViewer');
      const galleryItems = document.querySelectorAll('.gallery-item img');
      const faqQuestions = document.querySelectorAll('.faq-question');
      const reviewGrid = document.getElementById('reviewGrid');
      const writeReviewBtn = document.getElementById('writeReviewBtn');
      const heroVideoTrigger = document.getElementById('heroVideoTrigger');
      const heroVideoModal = document.getElementById('heroVideoModal');
      const closeHeroVideo = document.getElementById('closeHeroVideo');
      const heroWatchFilmBtn = document.getElementById('heroWatchFilmBtn');
      const heroVideoIframe = document.getElementById('heroVideoIframe');
      const thumbnailStrip = document.getElementById('thumbnailStrip');
      const bundleSelector = document.getElementById('bundleSelector');
      const sizeGuideBtn = document.getElementById('sizeGuideBtn');

      // Contact form
      const contactForm = document.getElementById('contactForm');
      const formSuccess = document.getElementById('formSuccess');
      const formError = document.getElementById('formError');

      // ----- state -----
      let cart = [];
      let quantity = 1;
      let selectedSize = 'M';
      let selectedColor = 'Midnight Black';
      let selectedBundle = 1;
      let bundlePrice = 89;
      const colorMap = {
        'Midnight Black': { hex: '#1e1e1e', image: 'https://images.unsplash.com/photo-1618354691373-d851c5c3a990?w=800&h=800&fit=crop&crop=center&auto=format' },
        'Stone': { hex: '#c6bdb2', image: 'https://images.unsplash.com/photo-1556905055-8f358a7a47b2?w=800&h=800&fit=crop&crop=center&auto=format' },
        'Bone': { hex: '#e8dfd3', image: 'https://images.unsplash.com/photo-1576566588028-4147f3842f27?w=800&h=800&fit=crop&crop=center&auto=format' }
      };

      // ----- helpers -----
      function updateCartUI() {
        const totalItems = cart.reduce((sum, item) => sum + item.qty, 0);
        cartCount.textContent = totalItems;
        mobileCartCount.textContent = totalItems;
        if (cart.length === 0) {
          cartItems.innerHTML = `<div class="cart-empty-state"><i class="fas fa-tshirt"></i><p>Your rotation starts here.</p><a href="#product-selection" style="text-decoration:underline; font-weight:500;">Shop the hoodie</a></div>`;
          cartFooter.style.display = 'none';
        } else {
          let html = '';
          let subtotal = 0;
          cart.forEach((item, idx) => {
            const itemTotal = item.qty * item.price;
            subtotal += itemTotal;
            html += `
              <div class="cart-item">
                <img src="${item.image || 'https://images.unsplash.com/photo-1618354691373-d851c5c3a990?w=100&h=100&fit=crop&crop=center&auto=format'}" alt="hoodie">
                <div class="cart-item-details">
                  <h4>NORTH/01 Signature Hoodie</h4>
                  <p>${item.size} · ${item.color}</p>
                  <p>$${itemTotal.toFixed(2)}</p>
                </div>
                <button class="cart-item-remove" data-index="${idx}"><i class="fas fa-times"></i></button>
              </div>
            `;
          });
          cartItems.innerHTML = html;
          cartFooter.style.display = 'block';
          cartSubtotal.textContent = `$${subtotal.toFixed(2)}`;
          cartTotal.textContent = `$${subtotal.toFixed(2)}`;
          document.querySelectorAll('.cart-item-remove').forEach(btn => {
            btn.addEventListener('click', function() {
              const idx = parseInt(this.dataset.index);
              cart.splice(idx, 1);
              updateCartUI();
              showToast('Removed from rotation.');
            });
          });
        }
      }

      function showToast(msg) {
        toast.textContent = msg;
        toast.classList.add('show');
        clearTimeout(toast._timer);
        toast._timer = setTimeout(() => toast.classList.remove('show'), 2200);
      }

      function getCurrentVariant() {
        const perUnit = bundlePrice / selectedBundle;
        return {
          size: selectedSize,
          color: selectedColor,
          qty: quantity * selectedBundle,
          price: perUnit,
          image: colorMap[selectedColor]?.image || colorMap['Midnight Black'].image
        };
      }

      function addToCartAction() {
        const variant = getCurrentVariant();
        const existing = cart.find(item => item.size === variant.size && item.color === variant.color);
        if (existing) {
          existing.qty += variant.qty;
        } else {
          cart.push({ ...variant });
        }
        updateCartUI();
        showToast('Added to your rotation.');
        cartTrigger.style.transform = 'scale(1.2)';
        setTimeout(() => cartTrigger.style.transform = 'scale(1)', 200);
        cartOverlay.classList.add('open');
        cartDrawer.classList.add('open');
      }

      function buyNowAction() {
        addToCartAction();
      }

      function updatePrice() {
        const perUnit = bundlePrice / selectedBundle;
        const total = perUnit * quantity;
        displayPrice.textContent = `$${total.toFixed(0)}`;
        stickyPrice.textContent = `$${total.toFixed(0)}`;
      }

      function updateColorImage(color) {
        const colorData = colorMap[color];
        if (colorData && mainImage) {
          mainImage.style.opacity = '0.6';
          setTimeout(() => {
            mainImage.src = colorData.image;
            mainImage.style.opacity = '1';
          }, 150);
        }
        stickyColor.style.background = colorData?.hex || '#1e1e1e';
      }

      // ----- bundle -----
      bundleSelector.addEventListener('click', (e) => {
        const btn = e.target.closest('button');
        if (!btn) return;
        bundleSelector.querySelectorAll('button').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        selectedBundle = parseInt(btn.dataset.bundle);
        bundlePrice = parseInt(btn.dataset.price);
        updatePrice();
      });

      // ----- size -----
      sizeSelector.addEventListener('click', (e) => {
        const btn = e.target.closest('button');
        if (!btn) return;
        sizeSelector.querySelectorAll('button').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        selectedSize = btn.dataset.size;
        stickySize.textContent = selectedSize;
      });

      // ----- color -----
      colorSelector.addEventListener('click', (e) => {
        const btn = e.target.closest('button');
        if (!btn) return;
        colorSelector.querySelectorAll('button').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        selectedColor = btn.dataset.color;
        updateColorImage(selectedColor);
      });

      // ----- quantity -----
      qtyDec.addEventListener('click', () => {
        if (quantity > 1) { quantity--; qtyDisplay.textContent = quantity; updatePrice(); }
      });
      qtyInc.addEventListener('click', () => {
        quantity++; qtyDisplay.textContent = quantity; updatePrice();
      });

      // ----- action buttons -----
      addToCartBtn.addEventListener('click', addToCartAction);
      buyNowBtn.addEventListener('click', buyNowAction);
      stickyAddToCart.addEventListener('click', addToCartAction);
      stickyBuyNow.addEventListener('click', buyNowAction);

      // ----- thumbnails -----
      thumbnailStrip.addEventListener('click', (e) => {
        const img = e.target.closest('img');
        if (!img) return;
        thumbnailStrip.querySelectorAll('img').forEach(i => i.classList.remove('active'));
        img.classList.add('active');
        if (img.dataset.main && mainImage) {
          mainImage.style.opacity = '0.6';
          setTimeout(() => {
            mainImage.src = img.dataset.main;
            mainImage.style.opacity = '1';
          }, 150);
        }
      });

      // ----- mobile nav -----
      function openMobileNav() {
        mobileNavOverlay.classList.add('open');
        mobileNavDrawer.classList.add('open');
        document.body.style.overflow = 'hidden';
      }
      function closeMobileNavFn() {
        mobileNavOverlay.classList.remove('open');
        mobileNavDrawer.classList.remove('open');
        document.body.style.overflow = '';
      }
      hamburger.addEventListener('click', openMobileNav);
      closeMobileNav.addEventListener('click', closeMobileNavFn);
      mobileNavOverlay.addEventListener('click', closeMobileNavFn);
      document.querySelectorAll('.mobile-nav-links a').forEach(link => {
        link.addEventListener('click', closeMobileNavFn);
      });

      // ----- cart drawer -----
      cartTrigger.addEventListener('click', () => {
        cartOverlay.classList.add('open');
        cartDrawer.classList.add('open');
      });
      closeCart.addEventListener('click', () => {
        cartOverlay.classList.remove('open');
        cartDrawer.classList.remove('open');
      });
      cartOverlay.addEventListener('click', () => {
        cartOverlay.classList.remove('open');
        cartDrawer.classList.remove('open');
      });

      // ----- sticky bar -----
      let stickyVisible = false;
      const productSelectionTop = document.getElementById('product-selection').offsetTop - 100;
      window.addEventListener('scroll', () => {
        const scrollY = window.scrollY;
        if (scrollY > productSelectionTop && !stickyVisible) {
          document.getElementById('stickyBar').classList.add('visible');
          stickyVisible = true;
        } else if (scrollY <= productSelectionTop && stickyVisible) {
          document.getElementById('stickyBar').classList.remove('visible');
          stickyVisible = false;
        }
      });

      // ----- hero video -----
      function openHeroVideo() {
        heroVideoModal.classList.add('open');
        document.body.style.overflow = 'hidden';
        heroVideoIframe.src = 'https://www.youtube.com/embed/dQw4w9WgXcQ?autoplay=1&mute=1&rel=0';
      }
      function closeHeroVideoFn() {
        heroVideoModal.classList.remove('open');
        document.body.style.overflow = '';
        heroVideoIframe.src = 'https://www.youtube.com/embed/dQw4w9WgXcQ?rel=0&mute=1';
      }
      heroVideoTrigger.addEventListener('click', openHeroVideo);
      heroWatchFilmBtn.addEventListener('click', openHeroVideo);
      closeHeroVideo.addEventListener('click', closeHeroVideoFn);
      heroVideoModal.addEventListener('click', (e) => {
        if (e.target === heroVideoModal) closeHeroVideoFn();
      });

      // ----- gallery viewer -----
      galleryItems.forEach(img => {
        img.addEventListener('click', () => {
          viewerImg.src = img.dataset.full || img.src;
          viewer.classList.add('open');
          document.body.style.overflow = 'hidden';
        });
      });
      closeViewer.addEventListener('click', () => {
        viewer.classList.remove('open');
        document.body.style.overflow = '';
      });
      viewer.addEventListener('click', (e) => {
        if (e.target === viewer) { viewer.classList.remove('open'); document.body.style.overflow = ''; }
      });

      // ----- FAQ -----
      faqQuestions.forEach(q => {
        q.addEventListener('click', function() {
          const targetId = this.dataset.target;
          const answer = document.getElementById(targetId);
          const isOpen = answer.classList.contains('open');
          document.querySelectorAll('.faq-answer').forEach(a => a.classList.remove('open'));
          document.querySelectorAll('.faq-question').forEach(q2 => q2.classList.remove('open'));
          if (!isOpen) {
            answer.classList.add('open');
            this.classList.add('open');
          }
        });
      });

      // ----- write review -----
      writeReviewBtn.addEventListener('click', () => {
        const name = prompt('Your name:');
        if (!name) return;
        const rating = prompt('Rating (1-5):');
        const reviewText = prompt('Your review:');
        if (!reviewText) return;
        const stars = '★'.repeat(Math.min(5, Math.max(1, parseInt(rating) || 5)));
        const card = document.createElement('div');
        card.className = 'review-card';
        card.innerHTML = `
          <div class="stars">${stars}</div>
          <p>"${reviewText}"</p>
          <div class="review-meta"><span><strong>${name}</strong> <span style="color:var(--color-success);">✓ Verified</span></span><span>Just now</span></div>
        `;
        reviewGrid.prepend(card);
        card.style.opacity = '0';
        requestAnimationFrame(() => { card.style.transition = 'opacity 0.5s'; card.style.opacity = '1'; });
      });

      // ----- size guide -----
      sizeGuideBtn.addEventListener('click', () => {
        alert('Size Guide: XS (34-36), S (36-38), M (38-40), L (40-42), XL (42-44), XXL (44-46). Model is 6\'1" wearing M.');
      });

      // ----- contact form -----
      contactForm.addEventListener('submit', function(e) {
        e.preventDefault();
        const name = document.getElementById('contactName').value.trim();
        const email = document.getElementById('contactEmail').value.trim();
        const subject = document.getElementById('contactSubject').value.trim();
        const message = document.getElementById('contactMessage').value.trim();

        // Simple validation
        if (!name || !email || !subject || !message || !email.includes('@')) {
          formError.classList.add('show');
          formSuccess.classList.remove('show');
          setTimeout(() => formError.classList.remove('show'), 4000);
          return;
        }

        // Simulate sending (in production, this would be a fetch/axios call)
        formError.classList.remove('show');
        formSuccess.classList.add('show');

        // Reset form
        contactForm.reset();

        setTimeout(() => {
          formSuccess.classList.remove('show');
        }, 5000);
      });

      // ----- init -----
      updateCartUI();
      updateColorImage('Midnight Black');
      stickySize.textContent = 'M';
      updatePrice();

    })();
  </script>
</body>
</html>