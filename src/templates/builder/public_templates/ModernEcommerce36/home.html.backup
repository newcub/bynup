          {% endif %}
          <div class="thumbnail-strip" id="thumbnailStrip">
            <img src="https://images.unsplash.com/photo-1618354691373-d851c5c3a990?w=100&h=100&fit=crop&crop=center&auto=format" data-main="https://images.unsplash.com/photo-1618354691373-d851c5c3a990?w=800&h=800&fit=crop&crop=center&auto=format" class="active" alt="Front" />
            <img src="https://images.unsplash.com/photo-1576566588028-4147f3842f27?w=100&h=100&fit=crop&crop=center&auto=format" data-main="https://images.unsplash.com/photo-1576566588028-4147f3842f27?w=800&h=800&fit=crop&crop=center&auto=format" alt="Back" />
            <img src="https://images.unsplash.com/photo-1556905055-8f358a7a47b2?w=100&h=100&fit=crop&crop=center&auto=format" data-main="https://images.unsplash.com/photo-1556905055-8f358a7a47b2?w=800&h=800&fit=crop&crop=center&auto=format" alt="Fabric" />
            <img src="https://images.unsplash.com/photo-1576871337632-b9aef4c17ab9?w=100&h=100&fit=crop&crop=center&auto=format" data-main="https://images.unsplash.com/photo-1576871337632-b9aef4c17ab9?w=800&h=800&fit=crop&crop=center&auto=format" alt="Hood" />
            <img src="https://images.unsplash.com/photo-1618354691551-44de113f0164?w=100&h=100&fit=crop&crop=center&auto=format" data-main="https://images.unsplash.com/photo-1618354691551-44de113f0164?w=800&h=800&fit=crop&crop=center&auto=format" alt="Cuff" />
          </div>
        </div>

        <div class="selection-content">
          <span class="eyebrow" id="section-36">{{ text_contents.35|default:"The Signature" }}</span>
          <h2 class="product-title" id="section-37">{{ text_contents.36|default:"NORTH/01 Signature Hoodie" }}</h2>
          <span class="product-price" id="displayPrice" id="section-38">$89</span>

          <div class="product-purchase-card" id="section-39">
            <div class="bundle-selector" id="bundleSelector">
              <button class="active" data-bundle="1" data-price="89" id="section-40">{{ text_contents.37|default:"1 Hoodie" }} <span class="save"></span></button>
              <button data-bundle="2" data-price="160" id="section-41">{{ text_contents.38|default:"2 Hoodies" }} <span class="save">{{ text_contents.39|default:"Save $18" }}</span></button>
              <button data-bundle="3" data-price="225" id="section-42">{{ text_contents.40|default:"3 Hoodies" }} <span class="save">{{ text_contents.41|default:"Save $42" }}</span></button>
            </div>

            <div class="purchase-options">
              <div class="option-group">
                <label id="section-43">{{ text_contents.42|default:"Size" }}</label>
                <div class="size-selector" id="sizeSelector">
                  <button data-size="XS" id="section-44">{{ text_contents.43|default:"XS" }}</button>
                  <button data-size="S" id="section-45">{{ text_contents.44|default:"S" }}</button>
                  <button class="active" data-size="M" id="section-46">{{ text_contents.45|default:"M" }}</button>
                  <button data-size="L" id="section-47">{{ text_contents.46|default:"L" }}</button>
                  <button data-size="XL" id="section-48">{{ text_contents.47|default:"XL" }}</button>
                  <button data-size="XXL" id="section-49">{{ text_contents.48|default:"XXL" }}</button>
                </div>
                <button class="size-guide-link" id="sizeGuideBtn" id="section-50">{{ text_contents.49|default:"View Size Guide" }}</button>
              </div>
              <div class="option-group">
                <label id="section-51">{{ text_contents.50|default:"Color" }}</label>
                <div class="color-swatches" id="colorSelector">
                  <button class="active swatch-black" data-color="Midnight Black" data-image="https://images.unsplash.com/photo-1618354691373-d851c5c3a990?w=800&h=800&fit=crop&crop=center&auto=format" aria-label="Midnight Black"></button>
                  <button class="swatch-stone" data-color="Stone" data-image="https://images.unsplash.com/photo-1556905055-8f358a7a47b2?w=800&h=800&fit=crop&crop=center&auto=format" aria-label="Stone"></button>
                  <button class="swatch-bone" data-color="Bone" data-image="https://images.unsplash.com/photo-1576566588028-4147f3842f27?w=800&h=800&fit=crop&crop=center&auto=format" aria-label="Bone"></button>
                </div>
              </div>
            </div>

            <div class="action-row">
              <div class="quantity-selector">
                <button id="qtyDec" id="section-52">-</button>
                <span id="qtyDisplay" id="section-53">1</span>
                <button id="qtyInc" id="section-54">+</button>
              </div>
              <button id="addToCartBtn" class="btn-add-to-cart" id="section-55"><i class="fas fa-shopping-bag"></i> {{ text_contents.51|default:"Add to Cart" }}</button>
              <button id="buyNowBtn" class="btn-buy-now" id="section-56"><i class="fas fa-bolt"></i> {{ text_contents.52|default:"Buy Now" }}</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Component Drop Zone - Before Story -->
