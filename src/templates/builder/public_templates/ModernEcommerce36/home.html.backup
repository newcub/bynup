                 alt="{{ image_customizations.1.alt_text|default:'{{ image_customizations.1.alt_text|default:' }}" 
                 class="editable-image" 
                 data-image="1">
        {% else %}
            <img src="https://images.pexels.com/photos/6311675/pexels-photo-6311675.jpeg?auto=compress&cs=tinysrgb&w=800" 
                 alt="{{ image_customizations.1.alt_text|default:" 
                 class="editable-image" 
                 data-image="1">
        {% endif %}
    {% endif %}
{% endwith %}
        {% else %}
          <img src="https://images.unsplash.com/photo-1618354691373-d851c5c3a990?w=800&h=600&fit=crop&crop=center&auto=format" alt="NORTH/01 brand film" data-image="1" style="width:100%; height:100%; object-fit:cover;" />
        {% endif %}
        <div class="play-overlay">
          <i class="fas fa-play-circle" data-icon="101"></i>
        </div>
        <span class="hero-video-badge" id="section-21"><i class="fas fa-play" style="margin-right:4px;"></i> {{ text_contents.17|default:"Watch the Film" }}</span>
      </div>

      <div class="hero-content">
        <span class="eyebrow" id="section-22"><i class="fas fa-tag" style="margin-right:6px;"></i> {{ text_contents.18|default:"NORTH/01 — SIGNATURE SERIES" }}</span>
        <h1 class="heading-xl" id="section-23">{{ text_contents.19|default:"MADE FOR THE EVERYDAY." }}</h1>
        <p class="body-large" id="section-24">{{ text_contents.20|default:"A heavyweight essential engineered for comfort, structure and everyday movement." }}</p>
        <div class="hero-rating">
          <i class="fas fa-star" style="color:#d4a04a;"></i><i class="fas fa-star" style="color:#d4a04a;"></i><i class="fas fa-star" style="color:#d4a04a;"></i><i class="fas fa-star" style="color:#d4a04a;"></i><i class="fas fa-star" style="color:#d4a04a;"></i>
          <span id="section-25">{{ text_contents.21|default:"4.9/5 &bull; 2,400+ verified customers" }}</span>
        </div>
        <div class="hero-cta-group">
          <a href="#product-selection" class="primary-action" id="section-26"><i class="fas fa-bolt"></i> {{ text_contents.22|default:"Shop Now" }}</a>
          <button class="secondary-action" id="heroWatchFilmBtn" id="section-27"><i class="fas fa-play"></i> {{ text_contents.23|default:"Watch the Film" }}</button>
        </div>
        <div class="hero-reassurance" id="section-28">
          <span><i class="fas fa-truck" data-icon="500"></i> {{ text_contents.24|default:"Free shipping" }}</span>
          <span><i class="fas fa-undo-alt" data-icon="501"></i> {{ text_contents.25|default:"Easy returns" }}</span>
          <span><i class="fas fa-lock" data-icon="502"></i> {{ text_contents.26|default:"Secure checkout" }}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust Bar -->
  <div class="container">
    <div class="trust-bar" id="section-29">
      <div class="trust-item" id="section-30"><i class="fas fa-weight-hanging" data-icon="504"></i><strong>{{ text_contents.27|default:"Heavyweight Fabric" }}</strong><span>{{ text_contents.28|default:"Premium structured cotton blend." }}</span></div>
      <div class="trust-item" id="section-31"><i class="fas fa-shield-alt" data-icon="505"></i><strong>{{ text_contents.29|default:"Built to Last" }}</strong><span>{{ text_contents.30|default:"Designed for repeated everyday wear." }}</span></div>
      <div class="trust-item" id="section-32"><i class="fas fa-undo-alt" data-icon="506"></i><strong>{{ text_contents.31|default:"Easy Returns" }}</strong><span>{{ text_contents.32|default:"30-day hassle-free returns." }}</span></div>
      <div class="trust-item" id="section-33"><i class="fas fa-lock" data-icon="507"></i><strong>{{ text_contents.33|default:"Secure Checkout" }}</strong><span>{{ text_contents.34|default:"Encrypted and trusted payment." }}</span></div>
